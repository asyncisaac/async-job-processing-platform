{
  "name": "async-job-processing-platform",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "tsc -p tsconfig.build.json",
    "build:full": "npm run prisma:generate && npm run build",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "migrate": "node scripts/migrate.mjs",
    "bootstrap": "node scripts/bootstrap.mjs",
    "deploy:api": "npm run migrate && npm start",
    "deploy:worker": "npm run migrate && npm run start:worker",
    "demo:key": "node scripts/create-demo-key.mjs",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down -v",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:reset": "prisma migrate reset --force --skip-seed",
    "setup": "node scripts/setup.mjs",
    "test": "vitest run",
    "test:full": "npm run setup && npm run test"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "bullmq": "^5.39.1",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "ioredis": "^5.4.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.73.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.215.0",
    "@opentelemetry/sdk-node": "^0.215.0",
    "pino": "^9.5.0",
    "pino-http": "^10.4.0",
    "prom-client": "^15.1.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.17.30",
    "@types/supertest": "^6.0.3",
    "prisma": "^5.20.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
